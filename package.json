{
  "name": "twitch-badge-collector-extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:i18n": "python3 scripts/check-i18n.py",
    "canary:chzzk": "tsx scripts/canary/chzzk.ts",
    "canary:badges": "tsx scripts/canary/badges.ts",
    "canary:socket": "tsx scripts/canary/socket.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lint": "6.9.7",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^3.0.1",
    "@radix-ui/react-select": "^2.4.1",
    "@tanstack/react-query": "^5.85.5",
    "@types/dompurify": "^3.0.5",
    "@uiw/react-codemirror": "4.25.12",
    "@zumer/snapdom": "^2.12.0",
    "axios": "^1.11.0",
    "dompurify": "^3.4.2",
    "html-to-image": "^1.11.13",
    "i18next": "^25.4.2",
    "nanoid": "^5.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@wxt-dev/module-react": "^1.1.3",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^20.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5",
    "wxt": "^0.20.6"
  }
}

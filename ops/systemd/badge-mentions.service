# 원본은 리포 ops/systemd/. 설치: cp ~/tbc/ops/systemd/badge-mentions.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now badge-mentions
# 사용자 서비스. 관리: systemctl --user {status,restart,stop} badge-mentions
# 로그: journalctl --user -u badge-mentions -f
[Unit]
Description=Badge Collector broadcast mention watch
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/bluewarn/tbc
ExecStart=/home/bluewarn/.nvm/versions/node/v24.22.0/bin/node --experimental-strip-types ops/watch/mentions.ts
Restart=on-failure
RestartSec=30
NoNewPrivileges=true

[Install]
WantedBy=default.target
